config_version=5

[application]

config/name="jardynn-game"
config/description="Visualizador 3D das camadas do jardim de Ynn geradas pelo pipeline Python (ynn-generator, gielis-equations, ose-rules, lotfp-rules)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[rendering]

renderer/rendering_method="mobile"
